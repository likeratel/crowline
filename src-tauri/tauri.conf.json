{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launchwatch",
  "version": "0.1.0",
  "identifier": "io.launchwatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Launchwatch",
        "width": 1080,
        "height": 780,
        "minWidth": 680,
        "minHeight": 580,
        "backgroundColor": "#f8faf8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/": "tools/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Your deployments, in sight.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
